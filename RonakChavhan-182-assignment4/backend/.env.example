# Server Configuration
PORT=5050
NODE_ENV=development

# Firebase Service Account Configuration
# Option 1: Path to serviceAccountKey.json file (relative to backend root or absolute path)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Alternatively provide individual credentials (if not using file)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBg...-----END PRIVATE KEY-----\n"
